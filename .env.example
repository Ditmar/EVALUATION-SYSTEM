# Base de datos (docker-compose expone Postgres en localhost:5432 para desarrollo local sin Docker)
DATABASE_URL=postgresql://exam_app:exam_app_password@localhost:5433/exam_system

# Autenticación docente
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false

# Usuario docente inicial (creado por prisma/seed.ts)
SEED_TEACHER_EMAIL=docente@example.com
SEED_TEACHER_NAME=Docente Administrador
SEED_TEACHER_PASSWORD=cambia-esta-clave

# Evaluación con IA (opcional, sólo si allowAiCodeEvaluation está habilitado en un examen)
# AI_PROVIDER selecciona el adaptador (ver lib/ai/factory.ts): "anthropic" u "openai".
# AI_API_KEY y AI_MODEL aplican al proveedor seleccionado, sea cual sea.
AI_PROVIDER=anthropic
AI_API_KEY=sk-ant-tu-api-key-aqui
AI_MODEL=claude-sonnet-5
# Para usar OpenAI en su lugar:
# AI_PROVIDER=openai
# AI_API_KEY=sk-tu-api-key-de-openai
# AI_MODEL=gpt-4o-mini

# Red / proxies
# Poner en "true" sólo si la app corre detrás de un proxy confiable (nginx, load balancer)
# que setea X-Forwarded-For correctamente. En caso contrario se usa la IP del socket.
TRUST_PROXY=false

NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development

# Cloudflare R2 (capturas de pantalla de exámenes con requireScreenCapture
# e imágenes subidas en preguntas type="image" de laboratorios).
# Bucket privado; token de API con permiso "Object Read & Write" sobre ese bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=exam-captures
# Opcional: dominio público del CDN de Cloudflare conectado al bucket (sin "/" final).
# Si se define, las imágenes se sirven desde el CDN; si no, con URLs firmadas temporales.
# OJO: con el CDN público, cualquier objeto del bucket es accesible por su URL.
R2_PUBLIC_URL=

# Ejecución de código en preguntas type="ide" (Piston self-hosted, ver
# docs/specs/piston-code-runner.md y docs/deploy/railway-piston.md).
# Nunca uses la API pública de emkc.org: requiere autorización y enviaría el
# código de los estudiantes a un tercero.
PISTON_URL=http://localhost:2000
# Opcional: si Piston está detrás de un proxy que exige "Authorization: Bearer <token>".
PISTON_AUTH_TOKEN=
# Versiones fijadas (deben estar instaladas: npm run piston:install).
PISTON_PYTHON_VERSION=3.12.0
PISTON_JAVA_VERSION=15.0.2
PISTON_TYPESCRIPT_VERSION=5.0.3
# Límites por ejecución (el cliente no puede cambiarlos).
CODE_RUN_TIMEOUT_MS=3000
CODE_COMPILE_TIMEOUT_MS=10000
CODE_RUN_MEMORY_MB=256
CODE_RUN_MAX_FILE_KB=64
CODE_RUN_MAX_TOTAL_KB=256
CODE_RUN_MAX_STDIN_KB=16
CODE_RUN_MAX_OUTPUT_KB=64
# Ejecuciones por minuto por intento/entrega, y simultáneas en toda la app.
CODE_RUN_RATE_PER_MIN=10
CODE_RUN_MAX_CONCURRENCY=4

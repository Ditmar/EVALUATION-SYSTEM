generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  ASSISTANT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  CODE
}

enum OnMaxPenalties {
  AUTO_SUBMIT
  WARN_ONLY
  LOCK_EXAM
}

enum DifferentIpPolicy {
  OFF
  WARN_ONLY
  BLOCK
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  LOCKED
}

enum ActivityEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  FULLSCREEN_EXIT
  HEARTBEAT
  RECONNECT
  OTHER
}

enum ExamAccessMode {
  OPEN
  REGISTERED
}

enum LaboratoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LaboratorySubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(TEACHER)
  // Instant revocation: checked fresh on every admin request (never cached in
  // the session JWT) so deactivating an account takes effect immediately
  // instead of waiting out the 8h session — see `requireAdminSession`.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Who created this account — null for "root" teacher accounts (created via
  // the seed script); set for ASSISTANT accounts a teacher creates so they
  // can only be managed by the teacher who created them.
  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreatedBy")

  exams         Exam[]
  gradedAnswers Answer[]                 @relation("GradedBy")
  subjects      Subject[]
  laboratories  Laboratory[]
  // Subjects an ASSISTANT account has been granted review access to — empty/unused for TEACHER accounts.
  subjectAccess SubjectAssistantAccess[] @relation("AssistantAccess")

  @@map("users")
}

// Grants a `role: ASSISTANT` account laboratory-review access to one
// `Subject` — the only thing an assistant can do (see
// `requireLaboratoryAccess` in `lib/auth/require-admin.ts`) is view/grade
// `LaboratorySubmission`s belonging to a `Laboratory` in a subject they have
// a row here for. Never grants access to Subjects/Students/Exams themselves,
// or to creating/editing/publishing Laboratories.
model SubjectAssistantAccess {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assistantId String
  assistant   User     @relation("AssistantAccess", fields: [assistantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([subjectId, assistantId])
  @@index([assistantId])
  @@map("subject_assistant_access")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams           Exam[]
  enrollments     Enrollment[]
  laboratories    Laboratory[]
  assistantAccess SubjectAssistantAccess[]

  @@unique([createdById, name])
  @@index([createdById])
  @@map("subjects")
}

model Student {
  id           String   @id @default(cuid())
  ci           String   @unique
  nombres      String
  apellidos    String
  correo       String?
  passwordHash String? // null hasta que el estudiante activa su cuenta
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments           Enrollment[]
  refreshTokens         StudentRefreshToken[]
  examAttempts          ExamAttempt[]
  laboratorySubmissions LaboratorySubmission[]

  @@map("students")
}

model Enrollment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, subjectId])
  @@index([subjectId])
  @@map("enrollments")
}

model StudentRefreshToken {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Constant across an entire rotation chain from one login; reuse of any
  // already-revoked token in the chain revokes the whole familyId at once.
  familyId          String
  revokedAt         DateTime?
  replacedByTokenId String?
  expiresAt         DateTime

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([familyId])
  @@map("student_refresh_tokens")
}

model Exam {
  id String @id @default(cuid())

  title           String
  career          String
  academicTerm    String
  subject         String
  examDate        DateTime
  durationMinutes Int
  instructions    String   @db.Text
  evaluationType  String

  maxPenalties          Int               @default(3)
  onMaxPenalties        OnMaxPenalties    @default(AUTO_SUBMIT)
  trackFocusEvents      Boolean           @default(true)
  monitorExternalIps    Boolean           @default(true)
  differentIpPolicy     DifferentIpPolicy @default(OFF)
  allowAiCodeEvaluation Boolean           @default(true)

  publicToken String    @unique
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  closedAt    DateTime?

  // `subject` (above) is legacy free text from the pasted exam JSON and is
  // kept as-is for backward compatibility. `subjectRef` is the first-class
  // materia used for categorization and REGISTERED-mode enrollment gating;
  // named "subjectRef" (not "subject") to avoid colliding with that legacy
  // scalar field.
  subjectId  String?
  subjectRef Subject?       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  accessMode ExamAccessMode @default(OPEN)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  attempts  ExamAttempt[]

  @@index([createdById])
  @@index([subjectId])
  @@map("exams")
}

model Question {
  id         String       @id @default(cuid())
  examId     String
  exam       Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  externalId String
  type       QuestionType
  statement  String       @db.Text
  points     Float
  order      Int

  options        Json?
  correctAnswer  String?
  correctAnswers Json?

  language           String?
  expectedSolution   String? @db.Text
  rubric             String? @db.Text
  enableAiEvaluation Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers Answer[]

  @@unique([examId, externalId])
  @@index([examId])
  @@map("questions")
}

model ExamAttempt {
  id     String @id @default(cuid())
  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  nombres       String
  apellidos     String
  ci            String
  correo        String
  acceptedTerms Boolean @default(true)

  // Set only for attempts created via the REGISTERED-mode /start endpoint;
  // null for anonymous OPEN-mode attempts (the default, unchanged flow).
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  expiresAt   DateTime
  submittedAt DateTime?

  observedIp   String?
  penaltyCount Int     @default(0)

  totalAutoScore   Float?
  totalManualScore Float?
  totalScore       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers        Answer[]
  activityEvents ActivityEvent[]

  @@unique([examId, ci])
  @@index([examId, status])
  @@index([studentId])
  @@map("exam_attempts")
}

model Answer {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOption  String?
  selectedOptions Json?
  codeAnswer      String? @db.Text

  isCorrect      Boolean?
  autoScore      Float?
  manualScore    Float?
  finalScore     Float?
  teacherComment String?  @db.Text

  gradedAt   DateTime?
  gradedById String?
  gradedBy   User?     @relation("GradedBy", fields: [gradedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiEvaluations AiEvaluation[]

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("answers")
}

model ActivityEvent {
  id        String            @id @default(cuid())
  attemptId String
  attempt   ExamAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      ActivityEventType
  detail    String?           @db.Text
  isPenalty Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([attemptId, createdAt])
  @@map("activity_events")
}

model AiEvaluation {
  id             String   @id @default(cuid())
  answerId       String
  answer         Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  suggestedScore Float
  feedback       String   @db.Text
  rawResponse    Json
  model          String
  createdAt      DateTime @default(now())

  @@index([answerId])
  @@map("ai_evaluations")
}

// Laboratories are authored as Markdown (Laboratory Markdown Specification
// v0.1, see lib/laboratory/laboratory-spec.md), not as normalized questions
// like Exam/Question — `markdownSource` is the source of truth, re-parsed on
// read via lib/laboratory/parse-laboratory.ts.
model Laboratory {
  id String @id @default(cuid())

  // The `id` from the Markdown frontmatter, not a routing slug (labs are
  // still routed by cuid, like exams) — unique per teacher, not globally.
  slug            String
  title           String
  markdownSource  String           @db.Text
  version         Int              @default(1)
  totalPoints     Float
  durationMinutes Int?
  status          LaboratoryStatus @default(DRAFT)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions  LaboratorySubmission[]
  repositories LaboratoryRepository[]

  @@unique([createdById, slug])
  @@index([createdById])
  @@index([subjectId])
  @@map("laboratories")
}

model LaboratorySubmission {
  id           String     @id @default(cuid())
  laboratoryId String
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)

  // A teacher may edit and republish a Laboratory after a student has
  // started answering it; `markdownSnapshot` is the exact source the student
  // answered against, so the submission stays reproducible and gradable
  // regardless of later edits (`laboratoryVersion` is kept alongside for
  // display/sorting, but the snapshot — not a version lookup — is the source
  // of truth for re-rendering/re-grading this submission).
  laboratoryVersion Int
  markdownSnapshot  String @db.Text

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status LaboratorySubmissionStatus @default(IN_PROGRESS)

  // { [questionId]: string | number | boolean | string[] }
  answers Json @default("{}")
  // { [questionId]: { evaluator, status, autoScore?, manualScore?, finalScore, feedback? } }
  grading Json @default("{}")

  totalScore Float?

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiEvaluations  LaboratoryAiEvaluation[]
  githubAttempts GitHubSubmissionAttempt[]

  @@unique([laboratoryId, studentId])
  @@index([laboratoryId, status])
  @@map("laboratory_submissions")
}

/// Mirrors AiEvaluation (exam code answers) but keyed by submission+question
/// id, since lab questions aren't normalized DB rows the way exam Answers are.
model LaboratoryAiEvaluation {
  id             String               @id @default(cuid())
  submissionId   String
  submission     LaboratorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId     String
  suggestedScore Float
  feedback       String               @db.Text
  /// [{ file, line?, reason }] — structured evidence for github-pr / rubric-graded reviews; null for older rows.
  evidence       Json?
  /// Model's self-reported 0..1 likelihood the answer was AI-generated rather than student-written; null for older rows or when unavailable.
  aiLikelihood   Float?
  rawResponse    Json
  model          String
  createdAt      DateTime             @default(now())

  @@index([submissionId])
  @@map("laboratory_ai_evaluations")
}

// A `{{repository}}` resource declared in a laboratory's Markdown. `commitSha`
// is the HEAD of `branch` resolved and frozen at the moment the laboratory
// was last actually published (not on every markdown edit) — every
// GitHubSubmissionAttempt's `baseCommitSha` is pinned to this value, so
// grading stays reproducible even if the branch moves after publishing.
// Null until the first publish, and reset to null if the teacher changes
// `repositoryUrl`/`branch` on an already-published lab (see the admin route
// that upserts this) until the lab is explicitly republished.
model LaboratoryRepository {
  id           String     @id @default(cuid())
  laboratoryId String
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)

  resourceId    String // the `id` from {{repository id="..."}}
  provider      String  @default("github")
  repositoryUrl String
  branch        String
  commitSha     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([laboratoryId, resourceId])
  @@index([laboratoryId])
  @@map("laboratory_repositories")
}

// One row per GitHub PR submission attempt for a (submission, question) pair.
// Only `github-pr` answers have a notion of "attempts" — every other answer
// type is already covered by autosave — so this is scoped narrowly here
// rather than restructuring LaboratorySubmission into a generic
// Submission/Attempt hierarchy. "Current" attempt = the row with the highest
// `attemptNumber` for a given (submissionId, questionId).
model GitHubSubmissionAttempt {
  id           String               @id @default(cuid())
  submissionId String
  submission   LaboratorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String

  attemptNumber Int

  sourceRepositoryUrl String
  sourceBranch        String

  headRepositoryOwner String
  headRepositoryName  String
  headBranch          String
  pullRequestUrl      String
  pullRequestNumber   Int
  /// "open" | "closed" | "merged" — validated in TS (lib/github/types.ts), not a Prisma enum: this mirrors how the schema already stores other external-system vocabulary as plain strings rather than minting enums for it.
  pullRequestState    String

  // `baseCommitSha` is a copied scalar, not a foreign key to
  // LaboratoryRepository.commitSha — this is what makes an already-created
  // attempt immune to the repository row's commitSha later being reset to
  // null (see LaboratoryRepository's doc comment above).
  baseCommitSha      String
  submittedCommitSha String

  filesChanged Int
  commitsCount Int
  additions    Int
  deletions    Int

  submittedAt DateTime @default(now())

  @@unique([submissionId, questionId, attemptNumber])
  @@index([submissionId, questionId])
  @@map("github_submission_attempts")
}

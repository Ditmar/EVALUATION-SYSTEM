# Dominio (o subdominio) apuntando con un registro A a la IP de este VPS.
PISTON_DOMAIN=piston.tu-dominio.com
# Token largo y aleatorio: openssl rand -hex 32
# El mismo valor va en PISTON_AUTH_TOKEN del servicio web en Railway.
PISTON_AUTH_TOKEN=
# Ejecuciones simultáneas: ~2 por vCPU, máximo 4. Igualar CODE_RUN_MAX_CONCURRENCY en Railway.
PISTON_MAX_CONCURRENT_JOBS=2
